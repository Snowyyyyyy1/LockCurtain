    <Compile Include="../../LockCurtain/DemonEyeArt.cs" Link="DemonEyeArt.cs" />
    <Compile Include="../../LockCurtain/TalismanArt.cs" Link="TalismanArt.cs" />
    <Compile Include="../../LockCurtain/ClockArt.cs" Link="ClockArt.cs" />
    <Compile Include="../../LockCurtain/VaultArt.cs" Link="VaultArt.cs" />
    <Compile Include="../../LockCurtain/PadlockArt.cs" Link="PadlockArt.cs" />
    <Compile Include="../../LockCurtain/CurtainBackground.cs" Link="CurtainBackground.cs" />
    <Compile Include="../../LockCurtain/TrayGlyphs.cs" Link="TrayGlyphs.cs" />
