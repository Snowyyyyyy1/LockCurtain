<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- 带 Windows SDK 版本号才能用 WinRT 的蓝牙 API（配对手机，Phone/PhoneLink.cs）；最低支持 Windows 10 2004（按地址类型连接要 19041） -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- 在 Mac 上用 Tools/make-icon.swift 生成（见文件头），和 Mac 的 App 图标同一张图 -->
    <ApplicationIcon>LockCurtain.ico</ApplicationIcon>
    <AssemblyName>LockCurtainApp</AssemblyName>
    <RootNamespace>LockCurtain</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Management" Version="10.0.14" />
    <!-- 配对手机：CPace 的 X25519 / Elligator2（Phone/Protocol/CPace.cs），钥匙用 DPAPI 存（Phone/PhoneStore.cs） -->
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.6.2" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.0" />
  </ItemGroup>

  <!-- 自动更新（Updater.cs）：公钥由 build.sh 从 LOCKCURTAIN_EDDSA_PUBLIC_KEY 传进来，没有就不检查更新；
       appcast 地址只能在编译时改（测试时指到本机），运行时改不了 -->
  <PropertyGroup>
    <AppcastUrl Condition="'$(AppcastUrl)' == ''">https://github.com/Snowyyyyyy1/LockCurtain/releases/latest/download/appcast-windows.xml</AppcastUrl>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyMetadata Include="EdDSAPublicKey" Value="$(EdDSAPublicKey)" />
    <AssemblyMetadata Include="AppcastUrl" Value="$(AppcastUrl)" />
  </ItemGroup>

</Project>
